<!DOCTYPE html>
<html>
  $partial("templates/head.html.in")$
  <body class="page">
    $partial("templates/header.html.in")$
    <article>
      <h1>$title$</h1>
      <section class="header">
        Posted on $date$
        $if(author)$
        by $author$
        $endif$
      </section>
      <section>
        $body$
      </section>
    </article>
  $partial("templates/footer.html.in")$
  </body>
</html>
