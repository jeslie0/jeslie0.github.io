<!DOCTYPE html>
<html lang="en">
  $partial("templates/head.html.in")$
  <body>
    $partial("templates/header.html.in")$
    <main role="main">
      <h1>$title$</h1>
      <h6>$date$</h6>
      <div class="container">
        <div class="image-section">
          <img src="$img$" loading="lazy" $if(img-alt)$alt="$img-alt$"$endif$>
        </div>

        <div class="text-section">
          $body$
        </div>
      </div>
    </main>
    $partial("templates/footer.html.in")$
  </body>
